# Copy to .env (gitignored) and fill in real values there. Never commit .env.
# Keys and allowed values: SPEC.md §15.5. A whole value of "changeme" or empty = not set (the backend
# uses its default); "changeme" inside DEMO_TEST_CARD_MAP's JSON is not (see below).

# Not read by the backend yet (SPEC §15.5). The provider is Anthropic (docs/llm-provider.md).
LLM_PROVIDER=changeme
LLM_API_KEY=changeme
# Default: claude-haiku-5-5
LLM_MODEL=changeme
# rules | llm (default: rules)
PARSER_MODE=changeme
# rules | llm (default: rules)
COVERAGE_MODE=changeme
# mock | visa_acceptance (default: mock)
PAY_MODE=changeme
VISA_ACCEPTANCE_MERCHANT_ID=changeme
VISA_ACCEPTANCE_KEY_ID=changeme
VISA_ACCEPTANCE_SECRET_KEY=changeme

# Needed for PAY_MODE=visa_acceptance (gate G4). A JSON object on one line: saved-card ID → card.
# Saved-card IDs: demo-visa-1234 (the demo card), demo-visa-4321, demo-mastercard-5678.
# Take the number from Cybersource's published test-card list (docs/visa-sandbox.md §5); use a Visa card.
# Only "number" is needed: expiry defaults to 12/2031 and no cvv is sent. Add "expMonth", "expYear"
# or "cvv" only with real test values. Inside this JSON "changeme" is NOT treated as unset: it would
# be sent to Cybersource as the expiry or cvv, and the payment fails.
# Wrap the JSON in single quotes here so `source .env` keeps it whole; paste it without them in
# Render's dashboard. Only the owner sets it. Never commit it, log it or paste it in chat.
#   DEMO_TEST_CARD_MAP='{"demo-visa-1234": {"number": "changeme"}}'
DEMO_TEST_CARD_MAP=changeme

# Not read by the backend yet (SPEC §15.5, docs/hosting.md).
PUBLIC_BASE_URL=changeme

# --- Optional (the backend's defaults are shown) ---
# LLM calls allowed per UTC day, per server process (hedges count). Past it, /v1/check uses the rules
# parser and /v1/coverage asks the user to pick the cause.
# LLM_DAILY_CAP=3000
# Seconds before one duplicate ("hedge") LLM request is sent; 0 turns hedging off.
# LLM_HEDGE_AFTER_S=2.0
# us | global (where Anthropic runs the model; "us" measured faster on Oct 15)
# LLM_INFERENCE_GEO=us
# POST /v1/check requests allowed per client IP per minute; 0 turns the limit off.
# RATE_LIMIT_PER_MIN=60
